# ═══════════════════════════════════════════════
#  Alban Production — configuration Apache / LiteSpeed
# ═══════════════════════════════════════════════

# ——— URLs propres : /sport → sport.html ———
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Supprime le .html de l'URL affichée (redirection permanente)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Sert le fichier .html correspondant sans l'exposer
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ——— Page 404 personnalisée ———
ErrorDocument 404 /404.html

# ——— Compression ———
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ——— Cache navigateur ———
# Les CSS et JS sont appelés avec une empreinte de contenu (?v=…) : on peut donc
# les mettre en cache longtemps, une modification changeant automatiquement l'URL.
# Le HTML, lui, ne doit jamais être servi depuis le cache, sinon les mises à jour
# du site restent invisibles pour les visiteurs déjà venus.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

# ——— En-têtes de sécurité et de confidentialité ———
<IfModule mod_headers.c>
  # Empêche le navigateur de deviner un type de fichier autre que celui annoncé
  Header always set X-Content-Type-Options "nosniff"

  # Ne transmet que le domaine — et non l'URL complète de la page consultée —
  # aux services extérieurs (lecteur Vimeo, liens sortants). Rien n'est envoyé
  # du tout si la destination n'est pas en HTTPS.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Le site n'utilise ni caméra, ni micro, ni géolocalisation, ni paiement :
  # on retire explicitement ces autorisations, y compris aux iframes.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # Interdit à un site tiers d'afficher celui-ci dans un cadre (habillage
  # frauduleux). N'empêche pas le site d'intégrer le lecteur Vimeo.
  Header always set X-Frame-Options "SAMEORIGIN"

  # HTTPS obligatoire pendant un an, sous-domaines compris. Le site force déjà
  # HTTPS par réécriture : cet en-tête évite le premier aller-retour en clair.
  # Ne pas activer « preload » sans certitude de rester en HTTPS durablement.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# Une politique de sécurité du contenu (CSP) complète n'est volontairement pas
# posée : le site contient des styles et des gestionnaires en ligne, une CSP
# stricte casserait l'affichage. La ligne upgrade-insecure-requests déjà servie
# par l'hébergeur couvre l'essentiel. Chantier à part entière si besoin.

<IfModule mod_headers.c>
  # Le HTML est systématiquement revalidé auprès du serveur
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Les assets versionnés sont immuables
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ——— Sources de construction : versionnées mais jamais servies ———
# (_src contient le fichier source et le script de generation ; les exposer
#  creerait du contenu duplique pour les moteurs de recherche)
RedirectMatch 404 ^/_src/
RedirectMatch 404 ^/_originaux/
RedirectMatch 404 ^/_pages/
